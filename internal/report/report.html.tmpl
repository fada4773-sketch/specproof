<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>apitest · {{.Title}}</title>
<style>
:root{
  --bg:#f4f5f7;--card:#ffffff;--text:#1a2130;--muted:#6b7385;--line:#e4e7ec;--soft:#f1f3f6;--head:#f8f9fb;
  --accent:#4f5fe8;--pass:#14a06a;--fail:#e5484d;--dev:#d4a000;--tol:#ee8a00;--skip:#9aa3b2;
  --fail2:#c4363b;--fail3:#f0777a;--fail4:#9e2a2e;--fail5:#ff9fa2;
  --c2:#14a06a;--c3:#3b82f6;--c4:#ee8a00;--c5:#e5484d;
  --shadow:0 1px 2px rgba(16,24,40,.05),0 1px 3px rgba(16,24,40,.07);
  --mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;
  --r:12px;color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --bg:#0e1117;--card:#161a22;--text:#e5e8ee;--muted:#9aa3b2;--line:#262c37;--soft:#1d222c;--head:#1a1f28;
  --accent:#8c96ff;--shadow:0 1px 2px rgba(0,0,0,.5);color-scheme:dark;
}}
:root[data-theme="dark"]{
  --bg:#0e1117;--card:#161a22;--text:#e5e8ee;--muted:#9aa3b2;--line:#262c37;--soft:#1d222c;--head:#1a1f28;
  --accent:#8c96ff;--shadow:0 1px 2px rgba(0,0,0,.5);color-scheme:dark;
}
:root[data-theme="light"]{color-scheme:light}
*{box-sizing:border-box}
html{scroll-padding-top:72px}
body{margin:0;background:var(--bg);color:var(--text);font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
code,pre,.mono{font-family:var(--mono);font-size:12.5px}
.wrap{max-width:1440px;margin:0 auto;padding:0 24px 56px}
.muted{color:var(--muted)}
.num{font-variant-numeric:tabular-nums}
.ell{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* top bar */
header.top{background:var(--card);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}
header.top .wrap{display:flex;align-items:center;gap:16px;padding-top:10px;padding-bottom:10px}
.brand{font-weight:700;white-space:nowrap}
.brand span{color:var(--muted);font-weight:500}
nav{display:flex;gap:2px;margin-left:auto;overflow-x:auto;scrollbar-width:none}
nav::-webkit-scrollbar{display:none}
nav a{color:var(--muted);padding:6px 10px;border-radius:8px;font-weight:500;text-decoration:none;white-space:nowrap}
nav a:hover{background:var(--soft);color:var(--text)}
.iconbtn{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:8px;padding:5px 10px;cursor:pointer}

/* hero */
.hero{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:26px 0 18px}
.hero h1{margin:0 0 6px;font-size:24px;line-height:1.2}
.meta{display:flex;flex-wrap:wrap;gap:4px 18px;color:var(--muted);font-size:13px}
.meta b{color:var(--text);font-weight:600}
.badge{flex:none;display:inline-flex;align-items:center;gap:8px;padding:9px 18px;border-radius:999px;font-weight:700;font-size:15px}
.badge.ok{background:color-mix(in srgb,var(--pass) 14%,transparent);color:var(--pass)}
.badge.bad{background:color-mix(in srgb,var(--fail) 14%,transparent);color:var(--fail)}
.alert{border:1px solid color-mix(in srgb,var(--fail) 40%,transparent);background:color-mix(in srgb,var(--fail) 7%,var(--card));padding:10px 16px;border-radius:var(--r);margin:0 0 16px}
.alert.warn{border-color:color-mix(in srgb,var(--dev) 45%,transparent);background:color-mix(in srgb,var(--dev) 8%,var(--card))}

/* cards and grids */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r);box-shadow:var(--shadow);min-width:0}
.pad{padding:16px 18px}
.card h3{margin:0;font-size:14.5px;display:flex;align-items:baseline;gap:8px}
.card h3 small{color:var(--muted);font-weight:500;font-size:12.5px}
.cardhead{display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding:14px 18px;border-bottom:1px solid var(--line)}
section{margin-top:30px}
section>h2{font-size:18px;margin:0 0 12px;display:flex;align-items:baseline;gap:10px}
section>h2 small{color:var(--muted);font-weight:500;font-size:13px}
.kpis{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:12px}
.three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:16px}
.three>.card{display:flex;flex-direction:column}
.stack-v{display:grid;gap:16px;margin-top:16px}
@media (max-width:1200px){.kpis{grid-template-columns:repeat(4,minmax(0,1fr))}.three{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:760px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.three{grid-template-columns:1fr}.hero{flex-direction:column;align-items:flex-start}.wrap{padding:0 16px 40px}}

/* KPIs */
.kpi{padding:14px 16px}
.kpi .l{color:var(--muted);font-size:11.5px;text-transform:uppercase;letter-spacing:.5px;font-weight:600}
.kpi .v{font-size:24px;font-weight:700;margin-top:2px;line-height:1.2;white-space:nowrap}
.kpi .s{color:var(--muted);font-size:12px;margin-top:2px}
.kpi.pass .v{color:var(--pass)}.kpi.fail .v{color:var(--fail)}.kpi.tol .v{color:var(--tol)}

/* status colors */
.s-passed{--c:var(--pass)}.s-failed{--c:var(--fail)}.s-schema-violation{--c:var(--fail2)}.s-example-mismatch{--c:var(--fail3)}
.s-data-mismatch{--c:var(--fail4)}.s-error{--c:var(--fail5)}.s-deviation{--c:var(--dev)}.s-tolerated{--c:var(--tol)}
.s-not-buildable,.s-skipped{--c:var(--skip)}
.dot{width:10px;height:10px;border-radius:3px;flex:none;background:var(--c)}
.seg{stroke:var(--c)}

/* donut */
.donutbox{display:flex;align-items:center;gap:20px;padding:14px 18px 18px;flex:1}
.donut{width:150px;height:150px;flex:none}
.donut .ring{stroke:var(--soft)}
.donut-n{font-size:8px;font-weight:700;fill:var(--text);text-anchor:middle}
.donut-l{font-size:3px;fill:var(--muted);text-anchor:middle;text-transform:uppercase;letter-spacing:.3px}
.legend{display:grid;gap:5px;flex:1;min-width:0;font-size:13px}
.legend div{display:flex;align-items:center;gap:8px;min-width:0}
.legend .n{margin-left:auto;color:var(--muted);white-space:nowrap}

/* bars */
.track{height:8px;border-radius:4px;background:var(--soft);overflow:hidden}
.track>span{display:block;height:100%;border-radius:4px;background:var(--accent)}
.track.thick{height:12px}
.stackbar{display:flex;height:12px;border-radius:6px;overflow:hidden;background:var(--soft)}
.stackbar span{display:block;height:100%;background:var(--c)}
.c2xx{background:var(--c2)!important}.c3xx{background:var(--c3)!important}.c4xx{background:var(--c4)!important}.c5xx{background:var(--c5)!important}

/* histogram */
.hist{display:flex;align-items:flex-end;gap:6px;height:140px;padding:16px 18px 0}
.hist .col{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:0}
.hist .col i{display:block;width:100%;max-width:40px;background:var(--accent);opacity:.85;border-radius:5px 5px 2px 2px;min-height:2px}
.hist .col b{font-size:11.5px;margin-bottom:3px;font-weight:600}
.histl{display:flex;gap:6px;padding:6px 18px 0}
.histl small{flex:1;color:var(--muted);font-size:10.5px;text-align:center;line-height:1.2;min-width:0}
.pcts{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:0;margin:14px 18px 18px;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.pcts div{padding:7px 4px;text-align:center;border-right:1px solid var(--line)}
.pcts div:last-child{border-right:0}
.pcts small{display:block;color:var(--muted);font-size:10.5px;text-transform:uppercase;letter-spacing:.4px}
.pcts b{font-size:13px;white-space:nowrap}

/* status codes */
.codes{display:grid;gap:8px;padding:14px 18px 18px}
.codes .r{display:grid;grid-template-columns:52px 1fr 44px;gap:10px;align-items:center;font-size:13px}
.codes .r span:last-child{text-align:right;color:var(--muted)}

/* tables */
table{width:100%;border-collapse:collapse}
th,td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--line);vertical-align:middle}
tbody tr:last-child td{border-bottom:0}
th{font-size:11.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--muted);font-weight:600;background:var(--head);white-space:nowrap}
td.r,th.r{text-align:right}
td.c,th.c{text-align:center}
table.fixed{table-layout:fixed}
.scroll{overflow-x:auto}
.pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:700;letter-spacing:.2px;white-space:nowrap;color:#fff;background:var(--c)}
.pill.s-error,.pill.s-deviation{color:#2b1a00}
.tag{display:inline-block;padding:0 7px;border-radius:6px;background:var(--soft);color:var(--muted);font-size:11px;margin-left:6px;vertical-align:1px;white-space:nowrap}
.two{display:block;min-width:0}
.two .sub{display:block;color:var(--muted);font-size:12px}
.method{display:inline-block;min-width:54px;font-weight:700;font-size:11.5px}

/* error matrix */
.matrixwrap{padding:14px 18px 18px;overflow-x:auto}
.matrix{width:auto;min-width:320px}
.matrix th,.matrix td{text-align:center;min-width:62px;border:1px solid var(--line)}
.matrix th:first-child,.matrix td:first-child{text-align:left;min-width:110px}
.cell.ok{background:color-mix(in srgb,var(--pass) calc(var(--a)*100%),transparent);font-weight:700}
.cell.bad{background:color-mix(in srgb,var(--fail) calc(var(--a)*100%),transparent);font-weight:700}
.cell.empty{color:var(--muted)}
.errsum{display:flex;gap:18px;flex-wrap:wrap;padding:14px 18px 0;font-size:13px}
.errsum b{font-size:18px;margin-right:4px}

/* cases */
.toolbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;padding:12px 16px;border-bottom:1px solid var(--line)}
.toolbar input{flex:1 1 260px;padding:7px 12px;border:1px solid var(--line);border-radius:9px;background:var(--bg);color:var(--text);font:inherit}
.chip{border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:999px;padding:4px 10px;font:inherit;font-size:12px;cursor:pointer;display:inline-flex;gap:6px;align-items:center}
.chip[aria-pressed="false"]{opacity:.4}
tr.case{cursor:default}
tr.case[data-id]{cursor:pointer}
tr.case:hover td{background:var(--soft)}
.caret{display:inline-block;width:12px;color:var(--muted);transition:transform .15s}
tr.case.open .caret{transform:rotate(90deg)}
tr.detail td{background:var(--soft);padding:16px 20px;white-space:normal}
tr.detail[hidden],tr.case[hidden]{display:none}
.timecell{display:flex;align-items:center;gap:8px;justify-content:flex-end}
.timecell .track{width:56px;height:6px;flex:none}
.msg{margin:0 0 12px;font-weight:500;overflow-wrap:anywhere}
.kv{display:grid;grid-template-columns:max-content 1fr;gap:3px 16px;margin:0 0 12px}
.kv dt{color:var(--muted)}.kv dd{margin:0;overflow-wrap:anywhere}
.box{border:1px solid var(--line);border-radius:10px;background:var(--card);margin:10px 0;overflow:hidden}
.box>summary{padding:8px 12px;cursor:pointer;font-weight:600;font-size:13px}
.box pre{margin:0;padding:12px;overflow:auto;max-height:420px;border-top:1px solid var(--line);white-space:pre-wrap;overflow-wrap:anywhere}
.copy{float:right;border:1px solid var(--line);background:var(--card);color:var(--text);border-radius:6px;padding:1px 8px;cursor:pointer;font-size:12px}
.innertable{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:var(--card);margin-bottom:12px}
.innertable td{overflow-wrap:anywhere}
.empty-state{padding:24px;text-align:center;color:var(--muted)}
ul.plain{margin:0;padding:14px 18px 16px 34px}
ul.plain li{margin:3px 0}
footer{margin-top:40px;color:var(--muted);font-size:12.5px;text-align:center}
</style>
</head>
<body>
<header class="top"><div class="wrap">
  <div class="brand">🧪 apitest <span>report</span></div>
  <nav>
    <a href="#dashboard">Dashboard</a>
    <a href="#tags">Tags</a>
    {{if .Slowest}}<a href="#slowest">Slowest</a>{{end}}
    {{if .S.Errors.Cases}}<a href="#errorcases">Error cases</a>{{end}}
    <a href="#cases">Cases</a>
    <a href="#coverage">Coverage</a>
    {{if .R.Deviations}}<a href="#deviations">Deviations</a>{{end}}
    {{if or .R.Findings .R.Warnings}}<a href="#hints">Hints</a>{{end}}
  </nav>
  <button class="iconbtn" type="button" id="theme" title="Light / dark">◐</button>
</div></header>

<main class="wrap">
  <div class="hero">
    <div style="min-width:0">
      <h1>{{.Title}}</h1>
      <div class="meta">
        <span>Spec <b class="mono">{{.R.SpecFile}}</b>{{if .R.OpenAPI}} · OpenAPI {{.R.OpenAPI}}{{end}}</span>
        <span>Base URL <b class="mono">{{.R.BaseURL}}</b></span>
        <span>Started <b>{{.Started}}</b></span>
        <span>Duration <b>{{.Duration}}</b></span>
        <span>Strict <b>{{if .R.Strict}}yes{{else}}no{{end}}</b></span>
      </div>
    </div>
    {{if .R.Passed}}<div class="badge ok">✓ Passed</div>{{else}}<div class="badge bad">✕ Failed</div>{{end}}
  </div>

  {{if .R.Aborted}}<div class="alert"><b>Run aborted:</b> {{.R.Aborted}}</div>{{end}}
  {{if .R.NotSelected}}<div class="alert warn">{{.R.NotSelected}} more cases were not selected by <code>go test -run</code>.</div>{{end}}

  <div id="dashboard">
    <div class="kpis">
      <div class="card kpi"><div class="l">Cases</div><div class="v num">{{.S.Total}}</div><div class="s ell">{{.Run}} run · {{.S.Executed}} answered</div></div>
      <div class="card kpi pass"><div class="l">Do not fail</div><div class="v num">{{.PassRate}}</div><div class="s ell">{{.S.Good}} of {{.Run}} run</div></div>
      <div class="card kpi {{if .S.Bad}}fail{{end}}"><div class="l">Fail</div><div class="v num">{{.S.Bad}}</div><div class="s ell">fail the test</div></div>
      <div class="card kpi {{if index .S.Counts "TOLERATED"}}tol{{end}}"><div class="l">Tolerated · dev.</div><div class="v num">{{index .S.Counts "TOLERATED"}} · {{index .S.Counts "DEVIATION"}}</div><div class="s ell">do not fail the test</div></div>
      <div class="card kpi"><div class="l">p95</div><div class="v num">{{ms .S.P95}}</div><div class="s ell">avg {{ms .S.Avg}} · p50 {{ms .S.P50}}</div></div>
      <div class="card kpi"><div class="l">Slowest</div><div class="v num">{{ms .S.Max}}</div><div class="s ell">{{ms .S.Sum}} in requests</div></div>
      <div class="card kpi"><div class="l">Coverage</div><div class="v num">{{.Coverage}}</div><div class="s ell">{{.R.Coverage.OperationsCovered}} of {{.R.Coverage.Operations}} operations</div></div>
    </div>

    <div class="three">
      <div class="card">
        <div class="cardhead"><h3>Cases by status</h3></div>
        <div class="donutbox">
          {{.Donut}}
          <div class="legend">
            {{range .Statuses}}<div class="s-{{status .Status}}"><span class="dot"></span><span class="ell">{{words .Status}}</span><span class="n num">{{.Count}} · {{.Pct}} %</span></div>{{end}}
          </div>
        </div>
      </div>

      <div class="card">
        <div class="cardhead"><h3>Response times <small>requests per range</small></h3></div>
        {{if .S.Executed}}
        <div class="hist">{{range .Hist}}<div class="col"><b class="num">{{if .Pct}}{{.Value}}{{end}}</b><i style="height: {{.Pct}}%" title="{{.Label}}: {{.Value}}"></i></div>{{end}}</div>
        <div class="histl">{{range .Hist}}<small>{{.Label}}</small>{{end}}</div>
        <div class="pcts">
          <div><small>avg</small><b class="num">{{ms .S.Avg}}</b></div>
          <div><small>p50</small><b class="num">{{ms .S.P50}}</b></div>
          <div><small>p90</small><b class="num">{{ms .S.P90}}</b></div>
          <div><small>p95</small><b class="num">{{ms .S.P95}}</b></div>
          <div><small>p99</small><b class="num">{{ms .S.P99}}</b></div>
          <div><small>max</small><b class="num">{{ms .S.Max}}</b></div>
        </div>
        {{else}}<div class="empty-state">No request was answered.</div>{{end}}
      </div>

      <div class="card">
        <div class="cardhead"><h3>Status codes <small>answers per code</small></h3></div>
        {{if .Codes}}<div class="codes">
          {{range .Codes}}<div class="r"><b class="mono">{{.Label}}</b><div class="track thick"><span class="{{.Class}}" style="width: {{.Pct}}%"></span></div><span class="num">{{.Value}}</span></div>{{end}}
        </div>{{else}}<div class="empty-state">No answers.</div>{{end}}
      </div>
    </div>
  </div>

  <section id="tags">
    <h2>Tags <small>{{len .Groups}} tags</small></h2>
    <div class="card scroll">
      <table class="fixed" style="min-width:820px">
        <colgroup><col style="width:22%"><col style="width:70px"><col><col style="width:60px"><col style="width:60px"><col style="width:70px"><col style="width:70px"><col style="width:90px"><col style="width:90px"></colgroup>
        <thead><tr><th>Tag</th><th class="r">Cases</th><th>Status</th><th class="r">✓</th><th class="r">✕</th><th class="r">tol./dev.</th><th class="r">not run</th><th class="r">Avg</th><th class="r">Total</th></tr></thead>
        <tbody>
        {{range .Groups}}<tr>
          <td class="ell" title="{{.Name}}"><b>{{.Name}}</b></td>
          <td class="r num">{{.Total}}</td>
          <td><div class="stackbar">{{range .Parts}}<span class="s-{{status .Status}}" style="width: {{.Pct}}%" title="{{.Status}}: {{.Count}}"></span>{{end}}</div></td>
          <td class="r num" style="color:var(--pass)">{{.Passed}}</td>
          <td class="r num" {{if .Bad}}style="color:var(--fail);font-weight:700"{{end}}>{{.Bad}}</td>
          <td class="r num">{{.Other}}</td>
          <td class="r num muted">{{.NotRun}}</td>
          <td class="r num">{{ms .Avg}}</td>
          <td class="r num muted">{{ms .Duration}}</td>
        </tr>{{end}}
        </tbody>
      </table>
    </div>
  </section>

  {{if .Slowest}}
  <section id="slowest">
    <h2>Slowest requests <small>top {{len .Slowest}}</small></h2>
    <div class="card scroll">
      <table class="fixed" style="min-width:820px">
        <colgroup><col style="width:44px"><col style="width:46%"><col style="width:150px"><col style="width:64px"><col><col style="width:84px"></colgroup>
        <thead><tr><th class="r">#</th><th>Request · case</th><th>Status</th><th class="r">Code</th><th></th><th class="r">Time</th></tr></thead>
        <tbody>
        {{range $i, $s := .Slowest}}<tr>
          <td class="r muted num">{{inc $i}}</td>
          <td><span class="two"><span class="mono ell" style="display:block" title="{{$s.Method}} {{$s.Target}}"><span class="method">{{$s.Method}}</span>{{$s.Target}}</span><span class="sub ell" title="{{label $s.Case}}">{{label $s.Case}}</span></span></td>
          <td><span class="pill s-{{status $s.Status}}">{{$s.Status}}</span></td>
          <td class="r mono">{{$s.Code}}</td>
          <td><div class="track thick"><span style="width: {{$s.Pct}}%"></span></div></td>
          <td class="r num"><b>{{ms $s.Duration}}</b></td>
        </tr>{{end}}
        </tbody>
      </table>
    </div>
  </section>
  {{end}}

  {{if .S.Errors.Cases}}
  <section id="errorcases">
    <h2>Error cases <small>expected error answers (404, 409, 5xx) and what came instead</small></h2>
    <div class="stack-v" style="margin-top:0">
      <div class="card">
        <div class="errsum">
          <span><b class="num">{{len .S.Errors.Cases}}</b>error cases</span>
          <span style="color:var(--pass)"><b class="num">{{.S.Errors.AsDocumented}}</b>as documented</span>
          <span style="color:var(--tol)"><b class="num">{{.S.Errors.Other}}</b>other{{if .R.Tolerate}} · tolerated, they do not fail the test{{end}}</span>
        </div>
        <div class="matrixwrap">
          <table class="matrix">
            <thead><tr><th>expected ↓ · got →</th>{{range .S.Errors.Actual}}<th class="mono">{{.}}</th>{{end}}</tr></thead>
            <tbody>{{range .Matrix}}<tr><td class="mono"><b>{{.Expected}}</b></td>{{range .Cells}}{{if .Count}}<td class="cell {{.Class}} num" style="--a: {{.Alpha}}">{{.Count}}</td>{{else}}<td class="cell empty">·</td>{{end}}{{end}}</tr>{{end}}</tbody>
          </table>
        </div>
      </div>
      <div class="card scroll">
        <table class="fixed" style="min-width:900px">
          <colgroup><col style="width:27%"><col style="width:28%"><col style="width:76px"><col style="width:66px"><col style="width:150px"><col></colgroup>
          <thead><tr><th>Case</th><th>Request</th><th class="r">Expected</th><th class="r">Got</th><th>Result</th><th>Answer</th></tr></thead>
          <tbody>
          {{range .S.Errors.Cases}}<tr>
            <td><span class="two"><span class="ell" style="display:block" title="{{label .}}">{{label .}}</span>{{with kind .Kind}}<span class="sub">{{.}}</span>{{end}}</span></td>
            <td class="mono ell" title="{{.Method}} {{.Target}}"><span class="method">{{.Method}}</span>{{.Target}}</td>
            <td class="r mono">{{.Expected}}</td>
            <td class="r mono"><b>{{if .Code}}{{.Code}}{{else}}–{{end}}</b></td>
            <td><span class="pill s-{{status .Status}}">{{.Status}}</span>{{if .Tolerated}}<div class="muted" style="font-size:11.5px">would be {{.Tolerated}}</div>{{end}}</td>
            <td class="muted ell" title="{{excerpt .}}">{{excerpt .}}</td>
          </tr>{{end}}
          </tbody>
        </table>
      </div>
    </div>
  </section>
  {{end}}

  <section id="cases">
    <h2>Cases <small>{{.S.Total}} cases · click a row for details</small></h2>
    <div class="card">
      <div class="toolbar">
        <input id="q" type="search" placeholder="Search case, path, status, message …" aria-label="search">
        {{range .Filters}}<button class="chip s-{{status .Status}}" type="button" aria-pressed="true" data-status="{{.Status}}"><span class="dot"></span>{{words .Status}} {{.Count}}</button>{{end}}
      </div>
      <div class="scroll">
      <table class="fixed" id="casetable" style="min-width:900px">
        <colgroup><col style="width:64px"><col style="width:34%"><col><col style="width:160px"><col style="width:64px"><col style="width:130px"></colgroup>
        <thead><tr><th>#</th><th>Case</th><th>Request</th><th>Status</th><th class="r">Code</th><th class="r">Time</th></tr></thead>
        <tbody>
        {{range .Cases}}
        <tr class="case" data-status="{{.Status}}" data-search="{{.Search}}" {{if .Details}}data-id="{{.ID}}" tabindex="0"{{end}}>
          <td class="muted num">{{if .Details}}<span class="caret">▸</span>{{else}}<span class="caret"></span>{{end}}{{if .Number}}{{.Number}}{{else}}{{.ID}}{{end}}</td>
          <td class="ell" title="{{.Name}}">{{.Name}}{{with kind .Kind}}<span class="tag">{{.}}</span>{{end}}{{if .Precondition}}<span class="tag">precondition</span>{{end}}</td>
          <td class="mono ell" title="{{.Method}} {{.Target}}">{{if .Method}}<span class="method">{{.Method}}</span>{{.Target}}{{else}}<span class="muted">–</span>{{end}}</td>
          <td><span class="pill s-{{status .Status}}">{{.Status}}</span></td>
          <td class="r mono">{{.Received}}</td>
          <td class="r"><div class="timecell num">{{ms .Duration}}{{if .Duration}}<div class="track"><span style="width: {{.BarPct}}%"></span></div>{{end}}</div></td>
        </tr>
        {{if .Details}}<tr class="detail" id="d{{.ID}}" hidden><td colspan="6">
          {{if .Message}}<p class="msg">{{.Message}}</p>{{end}}
          <dl class="kv">
            <dt>Case</dt><dd>{{.Name}}</dd>
            {{if .Method}}<dt>Request</dt><dd class="mono">{{.Method}} {{.Target}}</dd>{{end}}
            {{if .Expected}}<dt>Expected</dt><dd>{{.Expected}}</dd>{{end}}
            {{if .Actual}}<dt>Actual</dt><dd>{{.Actual}}</dd>{{end}}
            {{if .Tolerated}}<dt>Without tolerance</dt><dd>{{.Tolerated}}</dd>{{end}}
            {{if .Operation}}<dt>Operation</dt><dd class="mono">{{.Operation}}</dd>{{end}}
          </dl>
          {{if .Diffs}}<div class="innertable"><table><thead><tr><th>Pointer</th><th>Expected</th><th>Actual</th></tr></thead><tbody>
            {{range .Diffs}}<tr><td class="mono">{{.Pointer}}</td><td class="mono">{{.Expected}}</td><td class="mono">{{.Actual}}{{if .Note}} <span class="muted">({{.Note}})</span>{{end}}</td></tr>{{end}}
          </tbody></table></div>{{end}}
          {{if .Problems}}<div class="box"><div style="padding:8px 12px;font-weight:600;font-size:13px">Schema errors</div><ul class="plain" style="padding-top:0">{{range .Problems}}<li class="mono">{{.}}</li>{{end}}</ul></div>{{end}}
          {{if .Precondition}}<p class="muted">This case ran only as a precondition of a selected case.</p>{{end}}
          {{range bodies .Case}}<details class="box"><summary>{{.Title}}{{if .Original}} <span class="muted">(truncated, {{.Original}} bytes)</span>{{end}}</summary><pre>{{.Text}}</pre></details>{{end}}
          {{if .Curl}}<details class="box"><summary>Reproduce <button class="copy" type="button">copy</button></summary><pre class="curl">{{.Curl}}</pre></details>{{end}}
        </td></tr>{{end}}
        {{end}}
        </tbody>
      </table>
      </div>
      <div class="empty-state" id="none" hidden>No case matches the filter.</div>
    </div>
  </section>

  <section id="coverage">
    <h2>Coverage</h2>
    <div class="card pad">
      <div class="codes" style="padding:0;grid-template-columns:1fr">
        <div class="r" style="grid-template-columns:150px 1fr 80px"><span>Operations</span><div class="track thick"><span class="c2xx" style="width: {{.CovPct}}%"></span></div><span class="num">{{.R.Coverage.OperationsCovered}} / {{.R.Coverage.Operations}}</span></div>
        <div class="r" style="grid-template-columns:150px 1fr 80px"><span>Named examples</span><div class="track thick"><span style="width: {{.ExPct}}%"></span></div><span class="num">{{.R.Coverage.ExamplesCovered}} / {{.R.Coverage.Examples}}</span></div>
      </div>
    </div>
    {{if .R.Coverage.Uncovered}}<div class="card scroll" style="margin-top:12px"><table class="fixed" style="min-width:640px">
      <colgroup><col style="width:34%"><col></colgroup>
      <thead><tr><th>Uncovered operation</th><th>Reason</th></tr></thead>
      <tbody>{{range .R.Coverage.Uncovered}}<tr><td class="mono ell" title="{{.Operation}}">{{.Operation}}</td><td class="muted" style="overflow-wrap:anywhere">{{.Reason}}</td></tr>{{end}}</tbody>
    </table></div>{{end}}
  </section>

  {{if .R.Deviations}}
  <section id="deviations">
    <h2>Deviations <small class="mono">{{.R.DeviationsFile}}</small></h2>
    <div class="card scroll"><table style="min-width:900px">
      <thead><tr><th class="r">#</th><th>Case</th><th>Deviation</th><th>Reason</th><th>Ticket</th><th>Valid until</th><th class="r">Used</th><th>State</th></tr></thead>
      <tbody>{{range .R.Deviations}}<tr><td class="r num">{{.Index}}</td><td class="mono">{{.Case}}</td><td>{{.Rule}}</td><td>{{.Reason}}</td><td>{{.Ticket}}</td><td class="num">{{.Expires}}</td><td class="r num">{{.Uses}}</td><td>{{devstate .}}</td></tr>{{end}}</tbody>
    </table></div>
  </section>
  {{end}}

  {{if or .R.Findings .R.Warnings}}
  <section id="hints">
    <h2>Hints</h2>
    <div class="stack-v" style="margin-top:0">
      {{if .R.Warnings}}<div class="card"><div class="cardhead"><h3>Warnings <small>{{len .R.Warnings}}</small></h3></div><ul class="plain">{{range .R.Warnings}}<li>{{.}}</li>{{end}}</ul></div>{{end}}
      {{if .R.Findings}}<div class="card scroll"><table class="fixed" style="min-width:640px">
        <colgroup><col style="width:38%"><col></colgroup>
        <thead><tr><th>Spec location</th><th>Finding</th></tr></thead>
        <tbody>{{range .R.Findings}}<tr><td class="mono ell" title="{{.Where}}">{{.Where}}</td><td style="overflow-wrap:anywhere">{{.Message}}</td></tr>{{end}}</tbody>
      </table></div>{{end}}
    </div>
  </section>
  {{end}}

  <footer>Generated by apitest {{.R.Version}} with {{.R.GoVersion}}</footer>
</main>

<script>
(function(){
  var root=document.documentElement;
  try{var t=localStorage.getItem("apitest-theme");if(t)root.setAttribute("data-theme",t)}catch(e){}
  document.getElementById("theme").addEventListener("click",function(){
    var cur=root.getAttribute("data-theme");
    var dark=cur==="dark"||(!cur&&matchMedia("(prefers-color-scheme: dark)").matches);
    var next=dark?"light":"dark";root.setAttribute("data-theme",next);
    try{localStorage.setItem("apitest-theme",next)}catch(e){}
  });
  function toggle(row){
    var d=document.getElementById("d"+row.getAttribute("data-id"));if(!d)return;
    d.hidden=!d.hidden;row.classList.toggle("open",!d.hidden);
  }
  document.querySelectorAll("tr.case[data-id]").forEach(function(row){
    row.addEventListener("click",function(){toggle(row)});
    row.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();toggle(row)}});
  });
  var q=document.getElementById("q"),chips=document.querySelectorAll(".chip"),none=document.getElementById("none");
  function apply(){
    var text=q.value.trim().toLowerCase(),on={};
    chips.forEach(function(c){on[c.getAttribute("data-status")]=c.getAttribute("aria-pressed")==="true"});
    var shown=0;
    document.querySelectorAll("tr.case").forEach(function(row){
      var ok=on[row.getAttribute("data-status")]!==false&&(!text||row.getAttribute("data-search").indexOf(text)>=0);
      row.hidden=!ok;if(ok)shown++;
      var id=row.getAttribute("data-id"),d=id&&document.getElementById("d"+id);
      if(d&&!ok){d.hidden=true;row.classList.remove("open")}
    });
    none.hidden=shown>0;
  }
  q.addEventListener("input",apply);
  chips.forEach(function(c){c.addEventListener("click",function(){c.setAttribute("aria-pressed",c.getAttribute("aria-pressed")==="true"?"false":"true");apply()})});
  document.querySelectorAll("button.copy").forEach(function(b){
    b.addEventListener("click",function(e){
      e.preventDefault();e.stopPropagation();
      var pre=b.closest("details").querySelector("pre");
      if(navigator.clipboard)navigator.clipboard.writeText(pre.textContent).then(function(){b.textContent="copied";setTimeout(function(){b.textContent="copy"},1500)});
    });
  });
})();
</script>
</body>
</html>
